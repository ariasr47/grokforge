{
  "name": "grokforge",
  "version": "0.3.1",
  "private": true,
  "description": "Forge — ACP-native desktop agent shell (host + tools + diffs; Grok flagship)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n host,ui -c cyan,magenta \"npm run start --workspace @grokforge/host\" \"npm run dev --workspace @grokforge/shell\"",
    "start": "npm run start --workspace @grokforge/host",
    "dev:ui": "npm run dev --workspace @grokforge/shell",
    "dev:host": "npm run start --workspace @grokforge/host",
    "desktop": "npm run desktop:dev",
    "desktop:dev": "node scripts/tauri-dev.mjs --channel=dev",
    "desktop:prod": "node scripts/tauri-dev.mjs --channel=prod",
    "desktop:both": "node scripts/launch-both.mjs",
    "desktop:web": "node scripts/desktop.mjs",
    "desktop:web:dev": "node scripts/desktop.mjs --channel=dev",
    "desktop:tauri": "node scripts/tauri-dev.mjs --channel=dev",
    "desktop:tauri:build": "node scripts/tauri-build.mjs --channel=prod",
    "build:prod": "node scripts/tauri-build.mjs --channel=prod",
    "build:dev": "node scripts/tauri-build.mjs --channel=dev",
    "host:prod": "node scripts/run-host.mjs --channel=prod",
    "host:dev": "node scripts/run-host.mjs --channel=dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "smoke:brother": "node scripts/brother-smoke.mjs",
    "gate-q:dual-mode": "node --import tsx scripts/gate-q-dual-mode.mjs",
    "test:host-contract": "node scripts/host-contract.mjs",
    "e2e": "node scripts/e2e-shell.mjs",
    "verify": "npm run typecheck && npm test",
    "verify:full": "npm run verify && npm run test:host-contract && npm run gate-q:dual-mode"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
