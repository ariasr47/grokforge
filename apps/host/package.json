{
  "name": "@grokforge/host",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node ../../scripts/gen-allowed-origins.mjs && node ../../scripts/gen-build-version.mjs",
    "predev": "node ../../scripts/gen-allowed-origins.mjs && node ../../scripts/gen-build-version.mjs",
    "prebuild": "node ../../scripts/gen-allowed-origins.mjs && node ../../scripts/gen-build-version.mjs",
    "pretest": "node ../../scripts/gen-allowed-origins.mjs && node ../../scripts/gen-build-version.mjs",
    "pretypecheck": "node ../../scripts/gen-allowed-origins.mjs && node ../../scripts/gen-build-version.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@grokforge/acp-client": "*",
    "@grokforge/model-catalog": "*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
