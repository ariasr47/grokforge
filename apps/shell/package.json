{
  "name": "@grokforge/shell",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:e2e-tool-activity": "node scripts/e2e-tool-activity.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --import ./src/testEnv.ts --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:channel": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "tauri:build": "tauri build",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.conf.dev.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
