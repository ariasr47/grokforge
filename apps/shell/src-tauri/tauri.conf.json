{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.5.0",
  "identifier": "dev.grokforge.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Forge",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src https://www.google.com; media-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "ACP-native desktop agent shell",
    "longDescription": "Forge — open a workspace, talk to Grok (flagship agent), approve tools, review diffs. Local host + multi-agent ready.",
    "category": "DeveloperTool",
    "copyright": "Private",
    "externalBin": [],
    "resources": {
      "resources/runtime/node.exe": "resources/runtime/node.exe",
      "resources/runtime/LICENSE-node.txt": "resources/runtime/LICENSE-node.txt",
      "resources/host/index.js": "resources/host/index.js",
      "resources/agents/grok-acp/index.js": "resources/agents/grok-acp/index.js"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RjYwQzVDQ0Y1RDg3N0YKUldSL2gxM1BYQXoycWQrY3gwbmxhM0E2YlV3S1FiRmd0alFOTGhkQU80cEtJbTB4amw4UTRndHMK",
      "endpoints": [
        "https://github.com/ariasr47/grokforge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
