{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.3.1",
  "identifier": "dev.grokforge.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Forge",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "ACP-native desktop agent shell",
    "longDescription": "Forge — open a workspace, talk to Grok (flagship agent), approve tools, review diffs. Local host + multi-agent ready.",
    "category": "DeveloperTool",
    "copyright": "Private",
    "externalBin": []
  },
  "plugins": {}
}
