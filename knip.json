{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "ignore": [
        "docs/**",
        ".changeset/**",
        ".spire/**",
        ".grok/**",
        ".claude/**",
        ".codex/**",
        ".agents/**"
      ],
      "ignoreDependencies": [
        "concurrently"
      ]
    },
    "apps/shell": {
      "entry": [
        "src/main.tsx",
        "src/verifyGrokUi.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.vitest.ts",
        "src/**/*.vitest.tsx",
        "src/testEnv.ts",
        "src/test-support/**"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@tauri-apps/plugin-window-state"
      ]
    },
    "apps/host": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
