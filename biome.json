{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "apps/shell/src/ui/**",
      "apps/shell/src/state/**",
      "apps/shell/src/lib/copyClipboard.ts",
      "apps/shell/src/composer/CommandPalette.tsx",
      "apps/shell/src/lib/fonts.ts",
      "apps/shell/src/projections/runEventSchema.ts",
      "apps/shell/src/lib/desktopUpdate.ts",
      "apps/shell/src/lib/desktopNotify.ts",
      "apps/shell/src/thread/codeHighlightAsync.ts",
      "apps/shell/src/lib/csp.ts",
      "apps/shell/src/lib/crashSink.ts",
      "apps/shell/src/surfaces/BootScreen.tsx",
      "apps/shell/src/chrome/AppTopbar.tsx",
      "apps/shell/src/chrome/AppBanners.tsx",
      "apps/shell/src/composer/ComposerPane.tsx",
      "!**/*.css",
      "!**/dist",
      "!**/node_modules",
      "!.spire"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
